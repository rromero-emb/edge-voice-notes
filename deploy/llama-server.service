# Keeps the summary model loaded. Localhost only, and systemd blocks any other traffic.
[Unit]
Description=llama.cpp server for edge-voice-notes
After=local-fs.target

[Service]
User=evn
ExecStart=/usr/local/bin/llama-server -m /opt/models/summariser.gguf -c 4096 --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
Nice=10
IPAddressDeny=any
IPAddressAllow=localhost
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
